SELECT pg_get_functiondef('public.fn_descuento_cliente(integer)'::regprocedure);
                                pg_get_functiondef                                
----------------------------------------------------------------------------------
 CREATE OR REPLACE FUNCTION public.fn_descuento_cliente(p_id_cliente integer)    +
  RETURNS numeric                                                                +
  LANGUAGE plpgsql                                                               +
  STABLE                                                                         +
 AS $function$\r                                                                 +
 DECLARE\r                                                                       +
     v_descuento NUMERIC(5, 2);\r                                                +
 BEGIN\r                                                                         +
     SELECT t.descuento INTO v_descuento\r                                       +
     FROM cliente c JOIN tipo_cliente t USING (tipo_cliente)\r                   +
     WHERE c.id_cliente = p_id_cliente;\r                                        +
 \r                                                                              +
     IF NOT FOUND THEN\r                                                         +
         RAISE EXCEPTION 'El cliente con ID % no existe (RN-06)', p_id_cliente;\r+
     END IF;\r                                                                   +
 \r                                                                              +
     RETURN v_descuento;\r                                                       +
 END;\r                                                                          +
 $function$                                                                      +
 
