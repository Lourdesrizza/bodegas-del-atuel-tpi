-----------------------
 ETAPA5 D4 antiguo
(1 row)

SELECT d.nombre_o_razon_social,s.id_cliente IS NOT NULL subtipo_presente
FROM d4_clientes d LEFT JOIN socio s USING(id_cliente) ORDER BY 1;
