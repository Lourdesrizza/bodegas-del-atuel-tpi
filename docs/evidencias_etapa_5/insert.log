-- I1 · Dar cobertura a General Alvear con el transportista de menor actividad trimestral
-- LEFT JOIN incluye cero viajes y el código desempata. Si ya cubre la localidad, no se duplica.
BEGIN;
BEGIN
SELECT * FROM transportista_localidad WHERE cod_transportista=(SELECT t.cod_transportista
FROM transportista t LEFT JOIN ingreso i ON i.cod_transportista=t.cod_transportista
 AND i.fecha BETWEEN CURRENT_DATE-interval '3 months' AND CURRENT_DATE
GROUP BY t.cod_transportista ORDER BY count(i.cod_ingreso),t.cod_transportista LIMIT 1) AND id_localidad IN (SELECT id_localidad FROM localidad WHERE nombre='General Alvear' AND provincia='Mendoza');
 cod_transportista | id_localidad 
-------------------+--------------
                 1 |            2
(1 row)

INSERT INTO transportista_localidad SELECT t.cod_transportista,l.id_localidad FROM (SELECT t.cod_transportista
FROM transportista t LEFT JOIN ingreso i ON i.cod_transportista=t.cod_transportista
 AND i.fecha BETWEEN CURRENT_DATE-interval '3 months' AND CURRENT_DATE
GROUP BY t.cod_transportista ORDER BY count(i.cod_ingreso),t.cod_transportista LIMIT 1) t CROSS JOIN (SELECT id_localidad FROM localidad WHERE nombre='General Alvear' AND provincia='Mendoza') l ON CONFLICT DO NOTHING;
INSERT 0 0
SELECT * FROM transportista_localidad WHERE cod_transportista=(SELECT t.cod_transportista
FROM transportista t LEFT JOIN ingreso i ON i.cod_transportista=t.cod_transportista
 AND i.fecha BETWEEN CURRENT_DATE-interval '3 months' AND CURRENT_DATE
GROUP BY t.cod_transportista ORDER BY count(i.cod_ingreso),t.cod_transportista LIMIT 1) AND id_localidad IN (SELECT id_localidad FROM localidad WHERE nombre='General Alvear' AND provincia='Mendoza');
 cod_transportista | id_localidad 
-------------------+--------------
                 1 |            2
(1 row)

