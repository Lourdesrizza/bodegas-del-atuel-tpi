-- I3 · Crear venta de tres vinos para un cliente en sala 1
-- Cambiar cliente y sala en la cabecera y sala en la selección de stock.
-- El trigger asigna precio y descuento y actualiza stock e importes.
BEGIN;
BEGIN
CREATE TEMP TABLE vinos_venta AS SELECT cod_vino,cantidad FROM stock_sala
WHERE id_sala=1 AND cantidad>0 ORDER BY cod_vino LIMIT 3;
SELECT 3
SELECT * FROM vinos_venta ORDER BY cod_vino;
 cod_vino | cantidad 
----------+----------
        1 |       10
        2 |       10
        3 |       10
(3 rows)

DO $$ BEGIN
  IF (SELECT count(*) FROM vinos_venta) <> 3 THEN
    RAISE EXCEPTION 'I3 requiere tres vinos con stock disponible';
  END IF;
END $$;
DO
CREATE TEMP TABLE venta_nueva AS
WITH alta AS (INSERT INTO comprobante(id_cliente,id_sala,fecha)
VALUES (1,1,CURRENT_DATE) RETURNING nro_comprobante)
SELECT * FROM alta;
SELECT 1
INSERT INTO renglon_comprobante(nro_comprobante,cod_vino,cantidad)
SELECT n.nro_comprobante,v.cod_vino,1 FROM venta_nueva n CROSS JOIN vinos_venta v;
INSERT 0 3
SELECT c.nro_comprobante,c.total,f.total AS total_calculado
FROM comprobante c JOIN venta_nueva USING(nro_comprobante)
CROSS JOIN LATERAL fn_total_comprobante(c.nro_comprobante) f;
 nro_comprobante |  total  | total_calculado 
-----------------+---------+-----------------
          150001 | 2738.70 |         2738.70
(1 row)

SELECT s.cod_vino,v.cantidad AS antes,s.cantidad AS despues
FROM stock_sala s JOIN vinos_venta v USING(cod_vino) WHERE s.id_sala=1;
 cod_vino | antes | despues 
----------+-------+---------
        1 |    10 |       9
        2 |    10 |       9
        3 |    10 |       9
(3 rows)

