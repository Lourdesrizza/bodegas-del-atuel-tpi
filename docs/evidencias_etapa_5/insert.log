INSERT INTO maridaje(nombre,temperatura_servicio)
SELECT 'cordero al disco',17 WHERE EXISTS (SELECT FROM vino WHERE tipo='tinto' AND graduacion>=14)
AND NOT EXISTS (SELECT FROM maridaje WHERE nombre='cordero al disco');
INSERT 0 1
INSERT INTO vino_maridaje(cod_vino,id_maridaje)
SELECT v.cod_vino,m.id_maridaje FROM vino v CROSS JOIN maridaje m
WHERE v.tipo='tinto' AND v.graduacion>=14 AND m.nombre='cordero al disco'
ON CONFLICT DO NOTHING;
