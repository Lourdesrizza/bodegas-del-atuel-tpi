003_funciones.sql
-- ============================================================================
-- PROYECTO: Bodegas del Atuel
-- ETAPA 2: Funciones de Lógica y Cálculo (003_funciones.sql)
-- ============================================================================
-- ----------------------------------------------------------------------------
-- 1. fn_descuento_cliente
-- Propósito: Obtiene el porcentaje de descuento aplicable según el tipo de cliente (RN-06).
-- Parámetros: p_id_cliente (INTEGER) -> Identificador del cliente.
-- Retorno: NUMERIC(5, 2) -> Porcentaje de descuento (10.00, 20.00 o 30.00).
-- Volatilidad: STABLE (consulta la tabla cliente; no modifica datos).
-- ----------------------------------------------------------------------------
CREATE OR REPLACE FUNCTION fn_descuento_cliente(p_id_cliente INTEGER)
RETURNS NUMERIC(5, 2)
LANGUAGE plpgsql
STABLE
AS $$
DECLARE
    v_descuento NUMERIC(5, 2);
BEGIN
    SELECT t.descuento INTO v_descuento
    FROM cliente c JOIN tipo_cliente t USING (tipo_cliente)
    WHERE c.id_cliente = p_id_cliente;

    IF NOT FOUND THEN
        RAISE EXCEPTION 'El cliente con ID % no existe (RN-06)', p_id_cliente;
    END IF;

    RETURN v_descuento;
END;
$$;
CREATE FUNCTION
-- ----------------------------------------------------------------------------
-- 2. fn_stock_sala
-- Propósito: Consulta el stock disponible de un vino en una sala de venta específica (RN-09).
--            Si no existe registro previo para ese vino en la sala, retorna 0.
-- Parámetros: p_sala (INTEGER) -> ID de la sala de venta.
--             p_vino (INTEGER) -> Código del vino.
-- Retorno: INTEGER -> Cantidad de botellas disponibles.
-- Volatilidad: STABLE (consulta la tabla stock_sala; no modifica datos).
-- ----------------------------------------------------------------------------
CREATE OR REPLACE FUNCTION fn_stock_sala(p_sala INTEGER, p_vino INTEGER)
RETURNS INTEGER
LANGUAGE sql
STABLE
AS $$
    SELECT COALESCE(
        (SELECT cantidad
         FROM stock_sala
         WHERE id_sala = p_sala AND cod_vino = p_vino),
        0
    );
$$;
CREATE FUNCTION
-- ----------------------------------------------------------------------------
-- 3. fn_antiguedad_anios
-- Propósito: Calcula la antigüedad en años completos transcurridos entre una fecha y hoy.
-- Parámetros: p_fecha (DATE) -> Fecha base (ej. ingreso laboral o alta).
-- Retorno: INTEGER -> Años completos transcurridos.
-- Volatilidad: STABLE (utiliza CURRENT_DATE, invariable dentro de la misma transacción).
-- ----------------------------------------------------------------------------
CREATE OR REPLACE FUNCTION fn_antiguedad_anios(p_fecha DATE)
RETURNS INTEGER
LANGUAGE sql
STABLE
AS $$
    SELECT DATE_PART('year', AGE(CURRENT_DATE, p_fecha))::INTEGER;
$$;
CREATE FUNCTION
-- ----------------------------------------------------------------------------
-- 4. fn_total_comprobante
-- Propósito: Calcula el subtotal bruto, el monto de descuento y el total neto
--            de un comprobante sumando sus renglones (RN-08).
-- Parámetros: p_nro_comprobante (INTEGER) -> Número del comprobante.
-- Retorno: TABLE (subtotal NUMERIC, descuento NUMERIC, total NUMERIC)
-- Volatilidad: STABLE (lee tablas comprobante y renglon_comprobante sin alterar datos).
-- ----------------------------------------------------------------------------
CREATE OR REPLACE FUNCTION fn_total_comprobante(p_nro_comprobante INTEGER)
RETURNS TABLE (
    subtotal NUMERIC(12, 2),
    descuento NUMERIC(12, 2),
    total NUMERIC(12, 2)
)
LANGUAGE plpgsql
STABLE
AS $$
DECLARE
    v_subtotal_bruto NUMERIC(12, 2);
    v_monto_descuento NUMERIC(12, 2);
    v_total_neto NUMERIC(12, 2);
BEGIN
    IF NOT EXISTS (SELECT 1 FROM comprobante WHERE nro_comprobante = p_nro_comprobante) THEN
        RAISE EXCEPTION 'El comprobante % no existe', p_nro_comprobante;
    END IF;

    -- Sumar los importes brutos (cantidad * precio_unitario) de los renglones
    SELECT COALESCE(SUM(r.cantidad * r.precio_unitario), 0.00),
           COALESCE(SUM(r.cantidad * r.precio_unitario - r.subtotal_renglon), 0.00),
           COALESCE(SUM(r.subtotal_renglon), 0.00)
    INTO v_subtotal_bruto, v_monto_descuento, v_total_neto
    FROM renglon_comprobante r
    WHERE r.nro_comprobante = p_nro_comprobante;

    -- La suma de netos redondeados por renglón es la fuente de verdad.

    RETURN QUERY SELECT v_subtotal_bruto, v_monto_descuento, v_total_neto;
END;
$$;
CREATE FUNCTION

004_procedimientos.sql
-- ============================================================================
-- PROYECTO: Bodegas del Atuel
-- ETAPA 2: Procedimientos Almacenados Transaccionales (004_procedimientos.sql)
-- ============================================================================
-- ----------------------------------------------------------------------------
-- 1. sp_procesar_ingreso
-- Regla: RN-10 (Solo un ingreso terminado impacta en depósito y pasa a procesado)
-- Propósito: Bloquea la cabecera del ingreso, verifica que esté 'terminado',
--            suma las botellas de cada renglón a stock_deposito (creando el
--            registro si aún no existía) y actualiza el estado a 'procesado'.
-- Parámetros: p_cod_ingreso (INTEGER) -> Código del ingreso a procesar.
-- ----------------------------------------------------------------------------
CREATE OR REPLACE PROCEDURE sp_procesar_ingreso(p_cod_ingreso INTEGER)
LANGUAGE plpgsql
AS $$
DECLARE
    v_estado estado_documento;
    v_cant_renglones INTEGER;
    r RECORD;
BEGIN
    -- 1. Bloqueo pesimista de la fila del ingreso para evitar procesamiento concurrente
    SELECT estado INTO v_estado
    FROM ingreso
    WHERE cod_ingreso = p_cod_ingreso
    FOR UPDATE;

    IF NOT FOUND THEN
        RAISE EXCEPTION 'El ingreso % no existe (RN-10)', p_cod_ingreso;
    END IF;

    -- 2. Validación de estado requerido
    IF v_estado IS DISTINCT FROM 'terminado' THEN
        RAISE EXCEPTION 'El ingreso % se encuentra en estado "%", pero debe estar "terminado" para procesarse (RN-10)',
            p_cod_ingreso, v_estado;
    END IF;

    -- 3. Verificar que el documento contenga renglones
    SELECT COUNT(*) INTO v_cant_renglones
    FROM renglon_ingreso
    WHERE cod_ingreso = p_cod_ingreso;

    IF v_cant_renglones = 0 THEN
        RAISE EXCEPTION 'El ingreso % no contiene renglones asociados para procesar', p_cod_ingreso;
    END IF;

    -- 4. Incrementar el stock del depósito central (crea la fila si no existía)
    FOR r IN SELECT cod_vino,cantidad FROM renglon_ingreso
             WHERE cod_ingreso=p_cod_ingreso ORDER BY cod_vino LOOP
      INSERT INTO stock_deposito(cod_vino,cantidad) VALUES(r.cod_vino,r.cantidad)
      ON CONFLICT(cod_vino) DO UPDATE SET cantidad=stock_deposito.cantidad+EXCLUDED.cantidad;
    END LOOP;

    -- 5. Transición definitiva de estado
    UPDATE ingreso
    SET estado = 'procesado'::estado_documento
    WHERE cod_ingreso = p_cod_ingreso;

    RAISE NOTICE 'Ingreso % procesado exitosamente.', p_cod_ingreso;
END;
$$;
CREATE PROCEDURE
-- ----------------------------------------------------------------------------
-- 2. sp_procesar_transferencia
-- Reglas: RN-09, RN-11 (Impacto atómico de transferencias entre depósito y sala)
-- Propósito: Bloquea la transferencia, verifica estado 'terminado', controla que
--            el depósito central cuente con existencias suficientes de cada vino,
--            descuenta de depósito, suma al stock de la sala solicitante y pasa a 'procesado'.
-- Parámetros: p_nro_solicitud (INTEGER) -> Número de transferencia.
-- ----------------------------------------------------------------------------
CREATE OR REPLACE PROCEDURE sp_procesar_transferencia(p_nro_solicitud INTEGER)
LANGUAGE plpgsql
AS $$
DECLARE
    v_id_sala INTEGER;
    v_estado estado_documento;
    v_cant_renglones INTEGER;
    r RECORD;
    v_stock_deposito_actual INTEGER;
BEGIN
    -- 1. Bloqueo de la cabecera de la solicitud
    SELECT id_sala, estado INTO v_id_sala, v_estado
    FROM transferencia
    WHERE nro_solicitud = p_nro_solicitud
    FOR UPDATE;

    IF NOT FOUND THEN
        RAISE EXCEPTION 'La transferencia % no existe (RN-11)', p_nro_solicitud;
    END IF;

    -- 2. Validación de estado requerido
    IF v_estado IS DISTINCT FROM 'terminado' THEN
        RAISE EXCEPTION 'La transferencia % se encuentra en estado "%", pero debe estar "terminado" para procesarse (RN-11)',
            p_nro_solicitud, v_estado;
    END IF;

    -- 3. Verificar existencia de renglones
    SELECT COUNT(*) INTO v_cant_renglones
    FROM renglon_transferencia
    WHERE nro_solicitud = p_nro_solicitud;

    IF v_cant_renglones = 0 THEN
        RAISE EXCEPTION 'La transferencia % no posee renglones asociados', p_nro_solicitud;
    END IF;

    -- 4. Verificación y bloqueo de stock en depósito central por cada vino
    FOR r IN (
        SELECT cod_vino, cantidad
        FROM renglon_transferencia
        WHERE nro_solicitud = p_nro_solicitud
        ORDER BY cod_vino
    ) LOOP
        SELECT cantidad INTO v_stock_deposito_actual
        FROM stock_deposito
        WHERE cod_vino = r.cod_vino
        FOR UPDATE;

        IF NOT FOUND OR v_stock_deposito_actual < r.cantidad THEN
            RAISE EXCEPTION 'Stock insuficiente en depósito central para el vino % (disponible: %, requerido: %) (RN-11)',
                r.cod_vino, COALESCE(v_stock_deposito_actual, 0), r.cantidad;
        END IF;
    END LOOP;

    -- 5. Descontar botellas de stock_deposito (usando alias rt)
    FOR r IN SELECT cod_vino,cantidad FROM renglon_transferencia
             WHERE nro_solicitud=p_nro_solicitud ORDER BY cod_vino LOOP
      UPDATE stock_deposito SET cantidad=cantidad-r.cantidad WHERE cod_vino=r.cod_vino;
      INSERT INTO stock_sala(id_sala,cod_vino,cantidad) VALUES(v_id_sala,r.cod_vino,r.cantidad)
      ON CONFLICT(id_sala,cod_vino) DO UPDATE SET cantidad=stock_sala.cantidad+EXCLUDED.cantidad;
    END LOOP;

    -- 7. Transición definitiva de estado
    UPDATE transferencia
    SET estado = 'procesado'::estado_documento
    WHERE nro_solicitud = p_nro_solicitud;

    RAISE NOTICE 'Transferencia % procesada exitosamente para la sala %.', p_nro_solicitud, v_id_sala;
END;
$$;
CREATE PROCEDURE
CREATE OR REPLACE PROCEDURE sp_terminar_ingreso(p_id integer) LANGUAGE plpgsql AS $$
BEGIN
  UPDATE ingreso SET estado='terminado' WHERE cod_ingreso=p_id AND estado='en_confeccion';
  IF NOT FOUND THEN RAISE EXCEPTION 'Ingreso inexistente o no está en confección'; END IF;
END $$;
CREATE PROCEDURE
CREATE OR REPLACE PROCEDURE sp_terminar_transferencia(p_id integer) LANGUAGE plpgsql AS $$
BEGIN
  UPDATE transferencia SET estado='terminado' WHERE nro_solicitud=p_id AND estado='en_confeccion';
  IF NOT FOUND THEN RAISE EXCEPTION 'Transferencia inexistente o no está en confección'; END IF;
END $$;
CREATE PROCEDURE

005_triggers.sql
-- ============================================================================
-- PROYECTO: Bodegas del Atuel
-- ETAPA 2: Triggers y Reglas de Negocio Dinámicas (005_triggers.sql)
-- ============================================================================
-- ----------------------------------------------------------------------------
-- 1. VALIDACIÓN DE STOCK Y CÁLCULO DE IMPORTES EN RENGLÓN DE VENTA
-- Reglas: RN-01, RN-06, RN-08, RN-09
-- Tipo: BEFORE INSERT en renglon_comprobante
-- ----------------------------------------------------------------------------
CREATE OR REPLACE FUNCTION trg_fn_validar_renglon_venta()
RETURNS trigger
LANGUAGE plpgsql
AS $$
DECLARE
    v_sala INTEGER;
    v_cliente INTEGER;
    v_stock_disponible INTEGER;
    v_precio_actual NUMERIC(10, 2);
    v_descuento_pct NUMERIC(5, 2);
BEGIN
    -- Obtener la sala y el cliente del comprobante
    SELECT id_sala, id_cliente INTO v_sala, v_cliente
    FROM comprobante
    WHERE nro_comprobante = NEW.nro_comprobante;

    IF NOT FOUND THEN
        RAISE EXCEPTION 'El comprobante cabecera % no existe', NEW.nro_comprobante;
    END IF;

    -- RN-09: Validar existencia de stock suficiente en la sala
    v_stock_disponible := fn_stock_sala(v_sala, NEW.cod_vino);
    IF v_stock_disponible < NEW.cantidad THEN
        RAISE EXCEPTION 'Stock insuficiente del vino % en la sala % (disponible: %, solicitado: %) (RN-09)',
            NEW.cod_vino, v_sala, v_stock_disponible, NEW.cantidad;
    END IF;

    -- Obtener precio vigente del catálogo del vino (RN-01)
    SELECT precio INTO v_precio_actual
    FROM vino
    WHERE cod_vino = NEW.cod_vino;

    -- Fijar el precio histórico al momento de la venta
    NEW.precio_unitario := v_precio_actual;

    -- RN-06: Asignar descuento según tipo de cliente
    v_descuento_pct := fn_descuento_cliente(v_cliente);
    NEW.descuento_aplicado := v_descuento_pct;

    -- RN-08: Calcular el subtotal del renglón con descuento aplicado
    NEW.subtotal_renglon := ROUND(
        NEW.cantidad * NEW.precio_unitario * (1.0 - (v_descuento_pct / 100.0)),
        2
    );

    RETURN NEW;
END;
$$;
CREATE FUNCTION
DROP TRIGGER IF EXISTS trg_valida_stock_renglon ON renglon_comprobante;
DROP TRIGGER
CREATE TRIGGER trg_valida_stock_renglon
BEFORE INSERT ON renglon_comprobante
FOR EACH ROW
EXECUTE FUNCTION trg_fn_validar_renglon_venta();
CREATE TRIGGER
-- ----------------------------------------------------------------------------
-- 2. DESCUENTO DE STOCK Y ACTUALIZACIÓN DE TOTALES DEL COMPROBANTE
-- Reglas: RN-08, RN-09
-- Tipo: AFTER INSERT en renglon_comprobante
-- ----------------------------------------------------------------------------
CREATE OR REPLACE FUNCTION trg_fn_actualizar_stock_totales_venta()
RETURNS trigger
LANGUAGE plpgsql
AS $$
DECLARE
    v_sala INTEGER;
    v_totales RECORD;
BEGIN
    -- Obtener sala del comprobante
    SELECT id_sala INTO v_sala
    FROM comprobante
    WHERE nro_comprobante = NEW.nro_comprobante;

    -- RN-09: Descontar botellas vendidas del stock de la sala
    UPDATE stock_sala
    SET cantidad = cantidad - NEW.cantidad
    WHERE id_sala = v_sala AND cod_vino = NEW.cod_vino;

    -- RN-08: Recalcular y actualizar totales en la cabecera
    SELECT * INTO v_totales FROM fn_total_comprobante(NEW.nro_comprobante);

    UPDATE comprobante
    SET subtotal = v_totales.subtotal,
        descuento = v_totales.descuento,
        total = v_totales.total
    WHERE nro_comprobante = NEW.nro_comprobante;

    RETURN NEW;
END;
$$;
CREATE FUNCTION
DROP TRIGGER IF EXISTS trg_descuenta_stock_actualiza_totales ON renglon_comprobante;
DROP TRIGGER
CREATE TRIGGER trg_descuenta_stock_actualiza_totales
AFTER INSERT ON renglon_comprobante
FOR EACH ROW
EXECUTE FUNCTION trg_fn_actualizar_stock_totales_venta();
CREATE TRIGGER
-- ----------------------------------------------------------------------------
-- 3. CONTROL DE TRANSICIONES DE ESTADO EN INGRESOS
-- Regla: RN-10 (en_confeccion -> terminado -> procesado, sin retrocesos ni saltos)
-- Tipo: BEFORE UPDATE OF estado en ingreso
-- ----------------------------------------------------------------------------
CREATE OR REPLACE FUNCTION trg_fn_control_estados_ingreso()
RETURNS trigger
LANGUAGE plpgsql
AS $$
BEGIN
    IF OLD.estado = NEW.estado THEN
        RETURN NEW;
    END IF;

    IF OLD.estado = 'en_confeccion' AND NEW.estado <> 'terminado' THEN
        RAISE EXCEPTION 'Transición inválida en ingreso %: solo se puede pasar de "en_confeccion" a "terminado" (RN-10)',
            OLD.cod_ingreso;
    ELSIF OLD.estado = 'terminado' AND NEW.estado <> 'procesado' THEN
        RAISE EXCEPTION 'Transición inválida en ingreso %: solo se puede pasar de "terminado" a "procesado" (RN-10)',
            OLD.cod_ingreso;
    ELSIF OLD.estado = 'procesado' THEN
        RAISE EXCEPTION 'El ingreso % ya está procesado y su estado no puede modificarse (RN-10)',
            OLD.cod_ingreso;
    END IF;

    RETURN NEW;
END;
$$;
CREATE FUNCTION
DROP TRIGGER IF EXISTS trg_estado_ingreso ON ingreso;
DROP TRIGGER
CREATE TRIGGER trg_estado_ingreso
BEFORE UPDATE OF estado ON ingreso
FOR EACH ROW
EXECUTE FUNCTION trg_fn_control_estados_ingreso();
CREATE TRIGGER
-- ----------------------------------------------------------------------------
-- 4. CONTROL DE TRANSICIONES DE ESTADO EN TRANSFERENCIAS
-- Regla: RN-11 (en_confeccion -> terminado -> procesado, sin retrocesos ni saltos)
-- Tipo: BEFORE UPDATE OF estado en transferencia
-- ----------------------------------------------------------------------------
CREATE OR REPLACE FUNCTION trg_fn_control_estados_transferencia()
RETURNS trigger
LANGUAGE plpgsql
AS $$
BEGIN
    IF OLD.estado = NEW.estado THEN
        RETURN NEW;
    END IF;

    IF OLD.estado = 'en_confeccion' AND NEW.estado <> 'terminado' THEN
        RAISE EXCEPTION 'Transición inválida en transferencia %: solo se permite pasar de "en_confeccion" a "terminado" (RN-11)',
            OLD.nro_solicitud;
    ELSIF OLD.estado = 'terminado' AND NEW.estado <> 'procesado' THEN
        RAISE EXCEPTION 'Transición inválida en transferencia %: solo se permite pasar de "terminado" a "procesado" (RN-11)',
            OLD.nro_solicitud;
    ELSIF OLD.estado = 'procesado' THEN
        RAISE EXCEPTION 'La transferencia % ya está procesada y su estado no admite modificaciones (RN-11)',
            OLD.nro_solicitud;
    END IF;

    RETURN NEW;
END;
$$;
CREATE FUNCTION
DROP TRIGGER IF EXISTS trg_estado_transferencia ON transferencia;
DROP TRIGGER
CREATE TRIGGER trg_estado_transferencia
BEFORE UPDATE OF estado ON transferencia
FOR EACH ROW
EXECUTE FUNCTION trg_fn_control_estados_transferencia();
CREATE TRIGGER
-- ----------------------------------------------------------------------------
-- 5. FECHA DE CONFECCIÓN INMUTABLE EN TRANSFERENCIAS
-- Regla: RN-11 (La fecha de confección es la actual y no puede modificarse)
-- Tipo: BEFORE INSERT OR UPDATE en transferencia
-- ----------------------------------------------------------------------------
CREATE OR REPLACE FUNCTION trg_fn_fecha_confeccion_transferencia()
RETURNS trigger
LANGUAGE plpgsql
AS $$
BEGIN
    IF TG_OP = 'INSERT' THEN
        NEW.fecha_confeccion := CURRENT_DATE;
        RETURN NEW;
    ELSIF TG_OP = 'UPDATE' THEN
        IF NEW.fecha_confeccion IS DISTINCT FROM OLD.fecha_confeccion THEN
            RAISE EXCEPTION 'La fecha de confección de la transferencia no puede ser modificada (RN-11)';
        END IF;
        RETURN NEW;
    END IF;
    RETURN NEW;
END;
$$;
CREATE FUNCTION
DROP TRIGGER IF EXISTS trg_fecha_transferencia ON transferencia;
DROP TRIGGER
CREATE TRIGGER trg_fecha_transferencia
BEFORE INSERT OR UPDATE ON transferencia
FOR EACH ROW
EXECUTE FUNCTION trg_fn_fecha_confeccion_transferencia();
CREATE TRIGGER
-- ----------------------------------------------------------------------------
-- 6. BLOQUEO DE RENGLONES EN DOCUMENTOS NO EN CONFECCIÓN
-- Regla: RN-12 (No admite agregar, modificar ni quitar renglones si no está en confección)
-- Tipo: BEFORE INSERT OR UPDATE OR DELETE en renglon_ingreso y renglon_transferencia
-- ----------------------------------------------------------------------------
CREATE OR REPLACE FUNCTION trg_fn_bloqueo_renglones_ingreso()
RETURNS trigger
LANGUAGE plpgsql
AS $$
DECLARE
    v_cod_ingreso INTEGER;
    v_estado estado_documento;
BEGIN
    IF TG_OP = 'DELETE' THEN
        v_cod_ingreso := OLD.cod_ingreso;
    ELSE
        v_cod_ingreso := NEW.cod_ingreso;
    END IF;

    SELECT estado INTO v_estado
    FROM ingreso
    WHERE cod_ingreso = v_cod_ingreso;

    IF v_estado IS DISTINCT FROM 'en_confeccion' THEN
        RAISE EXCEPTION 'No se pueden modificar los renglones del ingreso % porque su estado es "%" (RN-12)',
            v_cod_ingreso, v_estado;
    END IF;

    IF TG_OP = 'DELETE' THEN
        RETURN OLD;
    END IF;
    RETURN NEW;
END;
$$;
CREATE FUNCTION
DROP TRIGGER IF EXISTS trg_bloqueo_renglon_ingreso ON renglon_ingreso;
DROP TRIGGER
CREATE TRIGGER trg_bloqueo_renglon_ingreso
BEFORE INSERT OR UPDATE OR DELETE ON renglon_ingreso
FOR EACH ROW
EXECUTE FUNCTION trg_fn_bloqueo_renglones_ingreso();
CREATE TRIGGER
CREATE OR REPLACE FUNCTION trg_fn_bloqueo_renglones_transferencia()
RETURNS trigger
LANGUAGE plpgsql
AS $$
DECLARE
    v_nro_solicitud INTEGER;
    v_estado estado_documento;
BEGIN
    IF TG_OP = 'DELETE' THEN
        v_nro_solicitud := OLD.nro_solicitud;
    ELSE
        v_nro_solicitud := NEW.nro_solicitud;
    END IF;

    SELECT estado INTO v_estado
    FROM transferencia
    WHERE nro_solicitud = v_nro_solicitud;

    IF v_estado IS DISTINCT FROM 'en_confeccion' THEN
        RAISE EXCEPTION 'No se pueden modificar los renglones de la transferencia % porque su estado es "%" (RN-12)',
            v_nro_solicitud, v_estado;
    END IF;

    IF TG_OP = 'DELETE' THEN
        RETURN OLD;
    END IF;
    RETURN NEW;
END;
$$;
CREATE FUNCTION
DROP TRIGGER IF EXISTS trg_bloqueo_renglon_transferencia ON renglon_transferencia;
DROP TRIGGER
CREATE TRIGGER trg_bloqueo_renglon_transferencia
BEFORE INSERT OR UPDATE OR DELETE ON renglon_transferencia
FOR EACH ROW
EXECUTE FUNCTION trg_fn_bloqueo_renglones_transferencia();
CREATE TRIGGER
-- ----------------------------------------------------------------------------
-- 7. AUDITORÍA DE PRECIOS DE VINO
-- Regla: RN-13 (Registra fecha, usuario, precio anterior y nuevo ante cambios de precio)
-- Tipo: AFTER UPDATE OF precio en vino
-- ----------------------------------------------------------------------------
CREATE OR REPLACE FUNCTION trg_fn_auditoria_precio_vino()
RETURNS trigger
LANGUAGE plpgsql
AS $$
BEGIN
    IF OLD.precio IS DISTINCT FROM NEW.precio THEN
        INSERT INTO auditoria_precio (
            cod_vino,
            precio_anterior,
            precio_nuevo,
            fecha_hora,
            usuario
        ) VALUES (
            NEW.cod_vino,
            OLD.precio,
            NEW.precio,
            CURRENT_TIMESTAMP,
            SESSION_USER
        );
    END IF;
    RETURN NEW;
END;
$$;
CREATE FUNCTION
DROP TRIGGER IF EXISTS trg_audita_precio_vino ON vino;
DROP TRIGGER
CREATE TRIGGER trg_audita_precio_vino
AFTER UPDATE OF precio ON vino
FOR EACH ROW
EXECUTE FUNCTION trg_fn_auditoria_precio_vino();
CREATE TRIGGER
-- ----------------------------------------------------------------------------
-- 8. SUMA DE PORCENTAJES DE CORTE (100%)
-- Regla: RN-05 (Los porcentajes de corte suman exactamente 100)
-- Tipo: CONSTRAINT TRIGGER DEFERRABLE INITIALLY DEFERRED en composicion
-- ----------------------------------------------------------------------------
CREATE OR REPLACE FUNCTION trg_fn_validar_porcentaje_corte()
RETURNS trigger
LANGUAGE plpgsql
AS $$
DECLARE
    v_cod_vino INTEGER;
    v_suma NUMERIC(6, 2);
BEGIN
    IF TG_OP = 'DELETE' THEN
        v_cod_vino := OLD.cod_vino;
    ELSE
        v_cod_vino := NEW.cod_vino;
    END IF;

    -- Validar si el vino todavía existe (evita errores en cascadas)
    IF EXISTS (SELECT 1 FROM vino WHERE cod_vino = v_cod_vino) THEN
        SELECT COALESCE(SUM(porcentaje), 0.00) INTO v_suma
        FROM composicion
        WHERE cod_vino = v_cod_vino;

        IF v_suma <> 100.00 THEN
            RAISE EXCEPTION 'La composición del vino % suma %, pero debe sumar exactamente 100 %% (RN-05)',
                v_cod_vino, v_suma;
        END IF;
    END IF;

    RETURN NULL;
END;
$$;
CREATE FUNCTION
DROP TRIGGER IF EXISTS trg_composicion_suma_cien ON composicion;
DROP TRIGGER
CREATE CONSTRAINT TRIGGER trg_composicion_suma_cien
AFTER INSERT OR UPDATE OR DELETE ON composicion
DEFERRABLE INITIALLY DEFERRED
FOR EACH ROW
EXECUTE FUNCTION trg_fn_validar_porcentaje_corte();
CREATE TRIGGER
-- Cierre de brechas detectadas en la revisión.
CREATE OR REPLACE FUNCTION trg_fn_cliente_subtipo() RETURNS trigger LANGUAGE plpgsql AS $$
DECLARE v_id integer; v_tipo text; v_n integer;
BEGIN
  v_id := CASE WHEN TG_TABLE_NAME = 'cliente' THEN COALESCE(NEW.id_cliente, OLD.id_cliente)
               ELSE COALESCE(NEW.id_cliente, OLD.id_cliente) END;
  SELECT tipo_cliente INTO v_tipo FROM cliente WHERE id_cliente = v_id;
  IF NOT FOUND THEN RETURN NULL; END IF;
  SELECT (EXISTS(SELECT 1 FROM socio WHERE id_cliente=v_id))::int +
         (EXISTS(SELECT 1 FROM distribuidor WHERE id_cliente=v_id))::int +
         (EXISTS(SELECT 1 FROM exportador WHERE id_cliente=v_id))::int INTO v_n;
  IF v_n <> 1 OR NOT (
      (v_tipo='socio' AND EXISTS(SELECT 1 FROM socio WHERE id_cliente=v_id)) OR
      (v_tipo='distribuidor' AND EXISTS(SELECT 1 FROM distribuidor WHERE id_cliente=v_id)) OR
      (v_tipo='exportador' AND EXISTS(SELECT 1 FROM exportador WHERE id_cliente=v_id))) THEN
    RAISE EXCEPTION 'Cliente %: subtipo ausente o incompatible (RN-06)', v_id;
  END IF;
  RETURN NULL;
END $$;
CREATE FUNCTION
CREATE CONSTRAINT TRIGGER trg_cliente_subtipo AFTER INSERT OR UPDATE OR DELETE ON cliente
DEFERRABLE INITIALLY DEFERRED FOR EACH ROW EXECUTE FUNCTION trg_fn_cliente_subtipo();
CREATE TRIGGER
CREATE CONSTRAINT TRIGGER trg_socio_subtipo AFTER INSERT OR UPDATE OR DELETE ON socio
DEFERRABLE INITIALLY DEFERRED FOR EACH ROW EXECUTE FUNCTION trg_fn_cliente_subtipo();
CREATE TRIGGER
CREATE CONSTRAINT TRIGGER trg_distribuidor_subtipo AFTER INSERT OR UPDATE OR DELETE ON distribuidor
DEFERRABLE INITIALLY DEFERRED FOR EACH ROW EXECUTE FUNCTION trg_fn_cliente_subtipo();
CREATE TRIGGER
CREATE CONSTRAINT TRIGGER trg_exportador_subtipo AFTER INSERT OR UPDATE OR DELETE ON exportador
DEFERRABLE INITIALLY DEFERRED FOR EACH ROW EXECUTE FUNCTION trg_fn_cliente_subtipo();
CREATE TRIGGER
CREATE OR REPLACE FUNCTION trg_fn_comprobante_inmutable() RETURNS trigger LANGUAGE plpgsql AS $$
BEGIN
  IF TG_OP='UPDATE' AND pg_trigger_depth() > 1 AND
     ROW(NEW.nro_comprobante,NEW.id_cliente,NEW.id_sala,NEW.fecha) IS NOT DISTINCT FROM
     ROW(OLD.nro_comprobante,OLD.id_cliente,OLD.id_sala,OLD.fecha) THEN RETURN NEW; END IF;
  RAISE EXCEPTION 'Comprobante emitido inmutable (RN-08)';
END $$;
CREATE FUNCTION
CREATE TRIGGER trg_comprobante_inmutable BEFORE UPDATE OR DELETE ON comprobante
FOR EACH ROW EXECUTE FUNCTION trg_fn_comprobante_inmutable();
CREATE TRIGGER
CREATE OR REPLACE FUNCTION trg_fn_renglon_venta_inmutable() RETURNS trigger LANGUAGE plpgsql AS $$
BEGIN RAISE EXCEPTION 'Renglón de venta emitido inmutable (RN-08/09)'; END $$;
CREATE FUNCTION
CREATE TRIGGER trg_renglon_venta_inmutable BEFORE UPDATE OR DELETE ON renglon_comprobante
FOR EACH ROW EXECUTE FUNCTION trg_fn_renglon_venta_inmutable();
CREATE TRIGGER
-- Bloqueo de cabecera durante el alta de renglones; serializa las ventas del mismo comprobante.
CREATE OR REPLACE FUNCTION trg_fn_validar_renglon_venta() RETURNS trigger LANGUAGE plpgsql AS $$
DECLARE v_sala integer; v_cliente integer; v_precio numeric(10,2); v_desc numeric(5,2);
BEGIN
  SELECT id_sala,id_cliente INTO v_sala,v_cliente FROM comprobante
  WHERE nro_comprobante=NEW.nro_comprobante FOR UPDATE;
  IF NOT FOUND THEN RAISE EXCEPTION 'Comprobante % inexistente',NEW.nro_comprobante; END IF;
  SELECT precio INTO v_precio FROM vino WHERE cod_vino=NEW.cod_vino;
  IF NOT FOUND THEN RAISE EXCEPTION 'Vino % inexistente',NEW.cod_vino; END IF;
  v_desc := fn_descuento_cliente(v_cliente);
  NEW.precio_unitario := v_precio;
  NEW.descuento_aplicado := v_desc;
  NEW.subtotal_renglon := ROUND(NEW.cantidad*v_precio*(1-v_desc/100),2);
  -- UPDATE atómico: la segunda sesión espera y luego observa el stock vigente.
  UPDATE stock_sala SET cantidad=cantidad-NEW.cantidad
  WHERE id_sala=v_sala AND cod_vino=NEW.cod_vino AND cantidad>=NEW.cantidad;
  IF NOT FOUND THEN RAISE EXCEPTION 'Stock insuficiente en sala para vino % (RN-09)',NEW.cod_vino; END IF;
  RETURN NEW;
END $$;
CREATE FUNCTION
-- El descuento se realiza en BEFORE INSERT; AFTER INSERT solo recalcula.
CREATE OR REPLACE FUNCTION trg_fn_actualizar_stock_totales_venta() RETURNS trigger LANGUAGE plpgsql AS $$
DECLARE v_totales record;
BEGIN
  SELECT * INTO v_totales FROM fn_total_comprobante(NEW.nro_comprobante);
  UPDATE comprobante SET subtotal=v_totales.subtotal, descuento=v_totales.descuento,
    total=v_totales.total WHERE nro_comprobante=NEW.nro_comprobante;
  RETURN NEW;
END $$;
CREATE FUNCTION
CREATE OR REPLACE FUNCTION trg_fn_bloqueo_renglones_ingreso() RETURNS trigger LANGUAGE plpgsql AS $$
DECLARE v_id integer; v_estado estado_documento;
BEGIN
  FOR v_id IN SELECT DISTINCT id FROM (VALUES
    (CASE WHEN TG_OP<>'INSERT' THEN OLD.cod_ingreso END),
    (CASE WHEN TG_OP<>'DELETE' THEN NEW.cod_ingreso END)) AS ids(id)
    WHERE id IS NOT NULL ORDER BY id LOOP
    SELECT estado INTO v_estado FROM ingreso WHERE cod_ingreso=v_id FOR UPDATE;
    IF v_estado IS DISTINCT FROM 'en_confeccion' THEN
      RAISE EXCEPTION 'Ingreso % cerrado: renglón inmutable (RN-12)',v_id;
    END IF;
  END LOOP;
  IF TG_OP='DELETE' THEN RETURN OLD; END IF; RETURN NEW;
END $$;
CREATE FUNCTION
CREATE OR REPLACE FUNCTION trg_fn_bloqueo_renglones_transferencia() RETURNS trigger LANGUAGE plpgsql AS $$
DECLARE v_id integer; v_estado estado_documento;
BEGIN
  FOR v_id IN SELECT DISTINCT id FROM (VALUES
    (CASE WHEN TG_OP<>'INSERT' THEN OLD.nro_solicitud END),
    (CASE WHEN TG_OP<>'DELETE' THEN NEW.nro_solicitud END)) AS ids(id)
    WHERE id IS NOT NULL ORDER BY id LOOP
    SELECT estado INTO v_estado FROM transferencia WHERE nro_solicitud=v_id FOR UPDATE;
    IF v_estado IS DISTINCT FROM 'en_confeccion' THEN
      RAISE EXCEPTION 'Transferencia % cerrada: renglón inmutable (RN-12)',v_id;
    END IF;
  END LOOP;
  IF TG_OP='DELETE' THEN RETURN OLD; END IF; RETURN NEW;
END $$;
CREATE FUNCTION
-- El ingreso sólo puede contener vinos elaborados por su bodega de origen.
CREATE OR REPLACE FUNCTION trg_fn_bloqueo_renglones_ingreso() RETURNS trigger LANGUAGE plpgsql AS $$
DECLARE v_id integer; v_estado estado_documento;
BEGIN
  FOR v_id IN SELECT DISTINCT id FROM (VALUES
    (CASE WHEN TG_OP<>'INSERT' THEN OLD.cod_ingreso END),
    (CASE WHEN TG_OP<>'DELETE' THEN NEW.cod_ingreso END)) AS ids(id)
    WHERE id IS NOT NULL ORDER BY id LOOP
    SELECT estado INTO v_estado FROM ingreso WHERE cod_ingreso=v_id FOR UPDATE;
    IF v_estado IS DISTINCT FROM 'en_confeccion' THEN
      RAISE EXCEPTION 'Ingreso % cerrado: renglón inmutable (RN-12)',v_id;
    END IF;
  END LOOP;
  IF TG_OP<>'DELETE' AND NOT EXISTS (
    SELECT 1 FROM ingreso i JOIN vino v ON v.cuit_bodega=i.cuit_bodega
    WHERE i.cod_ingreso=NEW.cod_ingreso AND v.cod_vino=NEW.cod_vino) THEN
    RAISE EXCEPTION 'El vino no pertenece a la bodega del ingreso';
  END IF;
  IF TG_OP='DELETE' THEN RETURN OLD; END IF; RETURN NEW;
END $$;
CREATE FUNCTION
-- Procesado se reserva a procedimientos; el rol API no recibe UPDATE de cabeceras.
CREATE OR REPLACE FUNCTION trg_fn_control_estados_ingreso() RETURNS trigger LANGUAGE plpgsql AS $$
BEGIN
  IF OLD.estado='en_confeccion' AND NEW.estado='terminado' THEN RETURN NEW; END IF;
  IF OLD.estado='terminado' AND NEW.estado='procesado' AND pg_trigger_depth()>0
     AND current_user='app_owner' THEN RETURN NEW; END IF;
  RAISE EXCEPTION 'Transición inválida de ingreso (RN-10)';
END $$;
CREATE FUNCTION
CREATE OR REPLACE FUNCTION trg_fn_control_estados_transferencia() RETURNS trigger LANGUAGE plpgsql AS $$
BEGIN
  IF OLD.estado='en_confeccion' AND NEW.estado='terminado' THEN RETURN NEW; END IF;
  IF OLD.estado='terminado' AND NEW.estado='procesado' AND current_user='app_owner' THEN RETURN NEW; END IF;
  RAISE EXCEPTION 'Transición inválida de transferencia (RN-11)';
END $$;
CREATE FUNCTION
CREATE OR REPLACE FUNCTION trg_fn_estado_inicial() RETURNS trigger LANGUAGE plpgsql AS $$
BEGIN
  IF NEW.estado <> 'en_confeccion' THEN RAISE EXCEPTION 'Estado inicial debe ser en_confeccion'; END IF;
  RETURN NEW;
END $$;
CREATE FUNCTION
CREATE TRIGGER trg_ingreso_inicial BEFORE INSERT ON ingreso FOR EACH ROW EXECUTE FUNCTION trg_fn_estado_inicial();
CREATE TRIGGER
CREATE TRIGGER trg_transferencia_inicial BEFORE INSERT ON transferencia FOR EACH ROW EXECUTE FUNCTION trg_fn_estado_inicial();
CREATE TRIGGER
CREATE OR REPLACE FUNCTION trg_fn_validar_porcentaje_corte() RETURNS trigger LANGUAGE plpgsql AS $$
DECLARE v_id integer; v_suma numeric;
BEGIN
  FOR v_id IN SELECT DISTINCT id FROM (VALUES
    (CASE WHEN TG_OP<>'INSERT' THEN OLD.cod_vino END),
    (CASE WHEN TG_OP<>'DELETE' THEN NEW.cod_vino END)) AS ids(id)
    WHERE id IS NOT NULL ORDER BY id LOOP
    IF EXISTS(SELECT 1 FROM vino WHERE cod_vino=v_id) THEN
      SELECT COALESCE(SUM(porcentaje),0) INTO v_suma FROM composicion WHERE cod_vino=v_id;
      IF v_suma<>100 THEN RAISE EXCEPTION 'Corte del vino % suma %; debe sumar 100 %% (RN-05)',v_id,v_suma; END IF;
    END IF;
  END LOOP;
  RETURN NULL;
END $$;
CREATE FUNCTION
CREATE OR REPLACE FUNCTION trg_fn_validar_vino_composicion() RETURNS trigger LANGUAGE plpgsql AS $$
DECLARE v_suma numeric;
BEGIN
  IF EXISTS(SELECT 1 FROM vino WHERE cod_vino=NEW.cod_vino) THEN
    SELECT COALESCE(SUM(porcentaje),0) INTO v_suma FROM composicion WHERE cod_vino=NEW.cod_vino;
    IF v_suma<>100 THEN RAISE EXCEPTION 'Corte del vino % suma %; debe sumar 100 %% (RN-05)',NEW.cod_vino,v_suma; END IF;
  END IF;
  RETURN NULL;
END $$;
CREATE FUNCTION
CREATE CONSTRAINT TRIGGER trg_vino_tiene_composicion AFTER INSERT OR UPDATE ON vino
DEFERRABLE INITIALLY DEFERRED FOR EACH ROW EXECUTE FUNCTION trg_fn_validar_vino_composicion();
CREATE TRIGGER

006_vistas.sql
-- ============================================================================
-- PROYECTO: Bodegas del Atuel
-- ETAPA 2: Vistas Analíticas y de Operación (006_vistas.sql)
-- ============================================================================
-- ----------------------------------------------------------------------------
-- 1. v_stock_total_vino
-- Propósito: Consolida el stock en el depósito central y en las salas de venta
--            por cada vino existente en el catálogo.
-- ----------------------------------------------------------------------------
CREATE OR REPLACE VIEW v_stock_total_vino AS
SELECT
    v.cod_vino,
    v.nombre AS vino,
    v.tipo,
    v.anada,
    v.volumen_ml,
    v.precio,
    COALESCE(sd.cantidad, 0) AS stock_deposito,
    COALESCE(ss.stock_salas, 0)::INTEGER AS stock_salas,
    (COALESCE(sd.cantidad, 0) + COALESCE(ss.stock_salas, 0))::INTEGER AS stock_total
FROM vino v
LEFT JOIN stock_deposito sd ON v.cod_vino = sd.cod_vino
LEFT JOIN (
    SELECT cod_vino, SUM(cantidad) AS stock_salas
    FROM stock_sala
    GROUP BY cod_vino
) ss ON v.cod_vino = ss.cod_vino;
CREATE VIEW
-- ----------------------------------------------------------------------------
-- 2. v_documentos_pendientes
-- Propósito: Monitorea todas las operaciones de ingresos y transferencias que
--            todavía no fueron procesadas (estados 'en_confeccion' o 'terminado').
-- ----------------------------------------------------------------------------
CREATE OR REPLACE VIEW v_documentos_pendientes AS
SELECT
    'ingreso' AS tipo_documento,
    i.cod_ingreso AS nro_documento,
    i.fecha AS fecha_emision,
    i.estado,
    b.razon_social AS origen,
    'Depósito Central' AS destino,
    t.razon_social AS transportista,
    COUNT(ri.cod_vino)::INTEGER AS cantidad_items,
    COALESCE(SUM(ri.cantidad), 0)::INTEGER AS total_botellas
FROM ingreso i
JOIN bodega b ON i.cuit_bodega = b.cuit
JOIN transportista t ON i.cod_transportista = t.cod_transportista
LEFT JOIN renglon_ingreso ri ON i.cod_ingreso = ri.cod_ingreso
WHERE i.estado <> 'procesado'
GROUP BY i.cod_ingreso, i.fecha, i.estado, b.razon_social, t.razon_social
UNION ALL
SELECT
    'transferencia' AS tipo_documento,
    tr.nro_solicitud AS nro_documento,
    tr.fecha_confeccion AS fecha_emision,
    tr.estado,
    'Depósito Central' AS origen,
    CONCAT('Sala ', s.id_sala, ' - ', l.nombre) AS destino,
    '-' AS transportista,
    COUNT(rt.cod_vino)::INTEGER AS cantidad_items,
    COALESCE(SUM(rt.cantidad), 0)::INTEGER AS total_botellas
FROM transferencia tr
JOIN sala_venta s ON tr.id_sala = s.id_sala
JOIN localidad l ON s.id_localidad = l.id_localidad
LEFT JOIN renglon_transferencia rt ON tr.nro_solicitud = rt.nro_solicitud
WHERE tr.estado <> 'procesado'
GROUP BY tr.nro_solicitud, tr.fecha_confeccion, tr.estado, s.id_sala, l.nombre;
CREATE VIEW
-- ----------------------------------------------------------------------------
-- 3. mv_ventas_mensuales_sala (Vista Materializada)
-- Propósito: Agrupa el volumen de comprobantes emitidos y montos facturados
--            por sala y período mensual. Acelera consultas de reportes.
-- ----------------------------------------------------------------------------
CREATE MATERIALIZED VIEW mv_ventas_mensuales_sala AS
SELECT
    c.id_sala,
    s.calle || ' ' || s.numero AS direccion_sala,
    l.nombre AS localidad,
    DATE_PART('year', c.fecha)::INTEGER AS anio,
    DATE_PART('month', c.fecha)::INTEGER AS mes,
    COUNT(c.nro_comprobante)::INTEGER AS cantidad_ventas,
    COALESCE(SUM(c.subtotal), 0.00)::NUMERIC(14, 2) AS subtotal_bruto,
    COALESCE(SUM(c.descuento), 0.00)::NUMERIC(14, 2) AS total_descuentos,
    COALESCE(SUM(c.total), 0.00)::NUMERIC(14, 2) AS total_facturado
FROM comprobante c
JOIN sala_venta s ON c.id_sala = s.id_sala
JOIN localidad l ON s.id_localidad = l.id_localidad
GROUP BY c.id_sala, s.calle, s.numero, l.nombre, DATE_PART('year', c.fecha), DATE_PART('month', c.fecha);
SELECT 0
-- Índice único sobre la vista materializada para permitir REFRESH CONCURRENTLY
CREATE UNIQUE INDEX uq_mv_ventas_mensuales_sala
ON mv_ventas_mensuales_sala (id_sala, anio, mes);
CREATE INDEX

007_roles.sql
-- Migración exclusiva de base nueva. Claves fuera del repositorio.
DO $$ BEGIN
  IF NOT EXISTS(SELECT 1 FROM pg_roles WHERE rolname='app_owner') THEN CREATE ROLE app_owner NOLOGIN; END IF;
  IF NOT EXISTS(SELECT 1 FROM pg_roles WHERE rolname='app_rw') THEN CREATE ROLE app_rw LOGIN; END IF;
  IF NOT EXISTS(SELECT 1 FROM pg_roles WHERE rolname='app_ro') THEN CREATE ROLE app_ro LOGIN; END IF;
END $$;
DO
DO $$ DECLARE x record; BEGIN
  FOR x IN SELECT c.relname,c.relkind FROM pg_class c JOIN pg_namespace n ON n.oid=c.relnamespace
           WHERE n.nspname='public' AND c.relkind IN ('r','v','m') LOOP
    EXECUTE format('ALTER %s public.%I OWNER TO app_owner',
      CASE x.relkind WHEN 'v' THEN 'VIEW'
      WHEN 'm' THEN 'MATERIALIZED VIEW' ELSE 'TABLE' END,x.relname);
  END LOOP;
  FOR x IN SELECT p.oid,p.prokind FROM pg_proc p JOIN pg_namespace n ON n.oid=p.pronamespace
           WHERE n.nspname='public' LOOP
    EXECUTE format('ALTER %s %s OWNER TO app_owner',
      CASE WHEN x.prokind='p' THEN 'PROCEDURE' ELSE 'FUNCTION' END,x.oid::regprocedure);
  END LOOP;
  ALTER TYPE estado_documento OWNER TO app_owner;
  ALTER DOMAIN cuit_dom OWNER TO app_owner;
END $$;
DO
REVOKE ALL ON SCHEMA public FROM PUBLIC;
REVOKE
REVOKE ALL ON ALL TABLES IN SCHEMA public FROM PUBLIC;
REVOKE
REVOKE ALL ON ALL SEQUENCES IN SCHEMA public FROM PUBLIC;
REVOKE
REVOKE ALL ON ALL ROUTINES IN SCHEMA public FROM PUBLIC;
REVOKE
GRANT USAGE ON SCHEMA public TO app_owner,app_rw,app_ro;
GRANT
GRANT CREATE ON SCHEMA public TO app_owner;
GRANT
GRANT USAGE ON TYPE estado_documento,cuit_dom TO app_rw,app_ro;
GRANT
GRANT SELECT ON ALL TABLES IN SCHEMA public TO app_rw,app_ro;
GRANT
GRANT SELECT,INSERT,UPDATE,DELETE ON localidad,sala_venta,empleado,finca,cepa,parcela,
  bodega,lote_uva,analisis_calidad,vino,composicion,maridaje,vino_maridaje,
  cliente,socio,distribuidor,exportador,permiso_exportacion,transportista,
  transportista_localidad TO app_rw;
GRANT
GRANT INSERT ON ingreso,transferencia,comprobante,renglon_ingreso,
  renglon_transferencia,renglon_comprobante TO app_rw;
GRANT
GRANT UPDATE,DELETE ON renglon_ingreso,renglon_transferencia TO app_rw;
GRANT
GRANT USAGE ON ALL SEQUENCES IN SCHEMA public TO app_rw;
GRANT
GRANT EXECUTE ON FUNCTION fn_descuento_cliente(integer),fn_stock_sala(integer,integer),
  fn_antiguedad_anios(date),fn_total_comprobante(integer) TO app_rw,app_ro;
GRANT
GRANT EXECUTE ON PROCEDURE sp_procesar_ingreso(integer),sp_procesar_transferencia(integer),
  sp_terminar_ingreso(integer),sp_terminar_transferencia(integer) TO app_rw;
GRANT
DO $$ DECLARE x record; BEGIN
  FOR x IN SELECT p.oid FROM pg_proc p JOIN pg_namespace n ON n.oid=p.pronamespace
           WHERE n.nspname='public' AND (p.proname LIKE 'trg_fn_%' OR p.proname LIKE 'sp_%') LOOP
    EXECUTE format('ALTER ROUTINE %s SECURITY DEFINER',x.oid::regprocedure);
    EXECUTE format('ALTER ROUTINE %s SET search_path = public, pg_temp',x.oid::regprocedure);
  END LOOP;
END $$;
DO
-- EXECUTE de funciones es global por defecto: revocar sin IN SCHEMA.
ALTER DEFAULT PRIVILEGES FOR ROLE app_owner REVOKE EXECUTE ON FUNCTIONS FROM PUBLIC;
ALTER DEFAULT PRIVILEGES
ALTER DEFAULT PRIVILEGES FOR ROLE app_owner IN SCHEMA public REVOKE ALL ON TABLES FROM PUBLIC;
ALTER DEFAULT PRIVILEGES
ALTER DEFAULT PRIVILEGES FOR ROLE app_owner IN SCHEMA public GRANT SELECT ON TABLES TO app_ro;
ALTER DEFAULT PRIVILEGES

008_indices.sql
-- Etapa 4. Índices adicionales sobre el esquema de 001–007.
BEGIN;
BEGIN
-- S3: primero igualdad por sala, después rango de fechas.
-- El cliente se proyecta para el JOIN y COUNT DISTINCT sin agregar una clave de orden.
CREATE INDEX idx_comprobante_sala_fecha
    ON public.comprobante (id_sala, fecha) INCLUDE (id_cliente);
CREATE INDEX
-- S8: intervalo de fechas para todas las salas. El índice también contiene
-- los datos necesarios para agrupar y sumar, si la visibilidad permite un Index Only Scan.
CREATE INDEX idx_comprobante_fecha_ventas
    ON public.comprobante (fecha) INCLUDE (id_sala, total);
CREATE INDEX
-- S4: cod_vino es FK y filtro de igualdad. La PK existente comienza por
-- nro_solicitud. El orden inverso permite buscar por vino antes de unir cabeceras.
CREATE INDEX idx_renglon_transferencia_vino_solicitud
    ON public.renglon_transferencia (cod_vino, nro_solicitud) INCLUDE (cantidad);
CREATE INDEX
-- S5: solo documentos pendientes. El predicado coincide con la consigna
-- y excluye el historial procesado. No depende de la fecha actual.
CREATE INDEX idx_transferencia_pendiente_sala
    ON public.transferencia (id_sala) INCLUDE (nro_solicitud)
    WHERE estado <> 'procesado';
CREATE INDEX
-- I1: por transportista (FK) y rango de fecha. También sirve para localizar
-- ingresos asociados al controlar el borrado o cambio de clave de un transportista.
CREATE INDEX idx_ingreso_transportista_fecha
    ON public.ingreso (cod_transportista, fecha);
CREATE INDEX
COMMIT;
COMMIT

